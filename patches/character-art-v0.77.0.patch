diff --git a/src/renderer/src/features/conversation/AgentSettingsPanel.avatar.test.tsx b/src/renderer/src/features/conversation/AgentSettingsPanel.avatar.test.tsx
new file mode 100644
index 0000000..e3f79ed
--- /dev/null
+++ b/src/renderer/src/features/conversation/AgentSettingsPanel.avatar.test.tsx
@@ -0,0 +1,67 @@
+import AgentSettingsPanel from "@openbot/ui/features/conversation/AgentSettingsPanel";
+import { fireEvent, render, screen } from "@solidjs/testing-library";
+import { describe, expect, it, vi } from "vitest";
+import { STORY_AGENT, STORY_AGENT_STATUS, STORY_MODELS, storyRuntimeSettings } from "../../preview/fixtures";
+
+class TestMediaQueryList extends EventTarget implements MediaQueryList {
+  readonly matches = false;
+  readonly media: string;
+  onchange: MediaQueryList["onchange"] = null;
+
+  constructor(media: string) {
+    super();
+    this.media = media;
+  }
+
+  addListener(_listener: (event: MediaQueryListEvent) => void): void {}
+  removeListener(_listener: (event: MediaQueryListEvent) => void): void {}
+}
+
+Object.defineProperty(window, "matchMedia", {
+  configurable: true,
+  value: (query: string) => new TestMediaQueryList(query),
+});
+
+function renderPanel(avatarSeed: string) {
+  const agent = { ...STORY_AGENT, avatarSeed };
+  render(() => (
+    <AgentSettingsPanel
+      agent={agent}
+      runtimeSettings={storyRuntimeSettings(agent)}
+      agentStatus={STORY_AGENT_STATUS}
+      modelOptions={STORY_MODELS}
+      working={false}
+      width={360}
+      maxWidth={() => 640}
+      onClose={vi.fn()}
+      onResize={vi.fn()}
+      onResizeEnd={vi.fn()}
+      onUpdateAgent={vi.fn(async () => undefined)}
+      onUpdateRuntimeSettings={vi.fn(async () => true)}
+      onSetAgentAvatar={vi.fn(async () => undefined)}
+    />
+  ));
+  fireEvent.click(screen.getByLabelText("Edit agent avatar"));
+}
+
+describe("agent avatar editor sections", () => {
+  it("shows only the character choices for a character seed", async () => {
+    renderPanel("character:mari-v1");
+
+    expect(await screen.findByText("Character")).toBeTruthy();
+    expect(screen.queryByText("Shape")).toBeNull();
+    expect(screen.queryByText("Eyes")).toBeNull();
+    expect(screen.queryByText("Color")).toBeNull();
+    expect(screen.getByLabelText("Mari")).toBeTruthy();
+    expect(screen.getByLabelText("Halo")).toBeTruthy();
+  });
+
+  it("keeps the generated avatar sections for a generated seed", async () => {
+    renderPanel("chief");
+
+    expect(await screen.findByText("Character")).toBeTruthy();
+    expect(screen.getByText("Shape")).toBeTruthy();
+    expect(screen.getByText("Eyes")).toBeTruthy();
+    expect(screen.getByText("Color")).toBeTruthy();
+  });
+});
diff --git a/src/renderer/src/features/sidebar/MariAvatar.test.tsx b/src/renderer/src/features/sidebar/MariAvatar.test.tsx
new file mode 100644
index 0000000..fd022a8
--- /dev/null
+++ b/src/renderer/src/features/sidebar/MariAvatar.test.tsx
@@ -0,0 +1,32 @@
+import { AgentAvatar } from "@openbot/ui/features/agents/AgentAvatar";
+import { render } from "@solidjs/testing-library";
+import { beforeEach, describe, expect, it, vi } from "vitest";
+
+const { mountMari } = vi.hoisted(() => ({ mountMari: vi.fn() }));
+vi.mock("../../../../../packages/ui/src/features/agents/mari-avatar", () => ({
+  MariAvatar: (props: { mood: string }) => {
+    mountMari(props.mood);
+    return <span />;
+  },
+}));
+
+beforeEach(() => vi.clearAllMocks());
+
+describe("persisted Mari avatar identity", () => {
+  it("resolves the built-in identity from an existing saved agent summary", async () => {
+    const agent = { avatarSeed: "character:mari-v1", avatarHue: null, avatarUrl: null };
+    render(() => <AgentAvatar agent={agent} mood="working" />);
+    expect(mountMari).toHaveBeenCalledExactlyOnceWith("working");
+  });
+
+  it("preserves explicit seed and photo precedence", async () => {
+    const agent = { avatarSeed: "character:mari-v1", avatarHue: null, avatarUrl: null };
+    const view = render(() => <AgentAvatar agent={agent} url="data:image/png;base64,eA==" />);
+    expect(mountMari).not.toHaveBeenCalled();
+    expect(view.container.querySelector('[data-avatar="image"]')).not.toBeNull();
+    view.unmount();
+    const legacy = render(() => <AgentAvatar agent={agent} seed="ordinary-agent" />);
+    expect(mountMari).not.toHaveBeenCalled();
+    expect(legacy.container.querySelector('[data-avatar="generated"]')).not.toBeNull();
+  });
+});

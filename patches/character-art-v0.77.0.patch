diff --git a/packages/contracts/src/team-protocol/character-art-v1.ts b/packages/contracts/src/team-protocol/character-art-v1.ts
new file mode 100644
index 0000000..2754b3b
--- /dev/null
+++ b/packages/contracts/src/team-protocol/character-art-v1.ts
@@ -0,0 +1,45 @@
+// Optional character-art-v1 wire contract (local addition).
+//
+// What it grants: any member who can reach the server reads the art of one character seed that the
+// host has in `<userData>/characters`. The art carries images only; it reads no agent data. A client
+// asks for the seed of an agent it already shows, so a new character reaches every client without a
+// client build. A host without the route answers an error and the client keeps its generated avatar.
+import { type CharacterArt, isCharacterArt, isCharacterSeed } from "../character-art";
+import { type AdminDecoder, adminRoute, fields, type OptionalRouteCodec } from "./admin-wire";
+import type { TeamProtocolV2Json } from "./v2";
+
+export const CHARACTER_ART_ROUTES = {
+  read: "/v1/character-art/read",
+} as const;
+
+const seed: AdminDecoder = (value) => {
+  if (typeof value !== "string" || !isCharacterSeed(value)) throw new Error("Invalid character seed.");
+  return value;
+};
+
+export function characterArtJson(art: CharacterArt): TeamProtocolV2Json {
+  return {
+    source: art.source,
+    base: art.base,
+    eyes: art.eyes.map((eye) => ({
+      name: eye.name,
+      cx: eye.cx,
+      cy: eye.cy,
+      angle: eye.angle,
+      bounds: [...eye.bounds],
+      darkBounds: [...eye.darkBounds],
+      pixelCount: eye.pixelCount,
+      image: eye.image,
+    })),
+    happyShapes: art.happyShapes.map((shape) => shape.map((point) => [...point])),
+  };
+}
+
+const art: AdminDecoder = (value) => {
+  if (!isCharacterArt(value)) throw new Error("Invalid character art.");
+  return characterArtJson(value);
+};
+
+export const CHARACTER_ART_CODECS: ReadonlyMap<string, OptionalRouteCodec> = new Map([
+  [CHARACTER_ART_ROUTES.read, adminRoute(fields({ seed }), fields({ seed, art }))],
+]);

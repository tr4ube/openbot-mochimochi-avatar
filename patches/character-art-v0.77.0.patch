@@ -0,0 +1,26 @@
+import type { AvatarMood } from "@openbot/brand/bloub-avatar-motion";
+import { createEffect, onSettled } from "solid-js";
+import { type MariArt, type MariController, mountMari } from "./mari-renderer";
+import "./mari-avatar.css";
+
+export function MariAvatar(props: { mood: AvatarMood; art: MariArt }) {
+  let host: HTMLSpanElement | undefined;
+  let controller: MariController | undefined;
+  const mode = () =>
+    props.mood === "responded"
+      ? "happy"
+      : props.mood === "working" || props.mood === "connecting"
+        ? "thinking"
+        : "idle";
+  onSettled(() => {
+    if (!host) return;
+    const avatar = mountMari(host, mode(), props.art);
+    controller = avatar;
+    return () => {
+      controller = undefined;
+      avatar.dispose();
+    };
+  });
+  createEffect(mode, (value) => controller?.setMode(value));
+  return <span ref={host} aria-hidden="true" style={{ display: "block", width: "100%", height: "100%" }} />;
+}
diff --git a/packages/ui/src/features/agents/mari-renderer.ts b/packages/ui/src/features/agents/mari-renderer.ts
new file mode 100644
index 0000000..b8191c1
--- /dev/null
+++ b/packages/ui/src/features/agents/mari-renderer.ts
@@ -0,0 +1,291 @@
+import motion from "./accepted-motion.css?inline";
+
+export type MariMode = "idle" | "thinking" | "happy";
+export interface MariController {
+  setMode(mode: MariMode): void;
+  pet(): void;
+  dispose(): void;
+}
+
+export interface MariArt {
+  source: string;
+  base: string;
+  eyes: {
+    name: string;
+    cx: number;
+    cy: number;
+    angle: number;
+    bounds: [number, number, number, number];
+    darkBounds: [number, number, number, number];
+    pixelCount: number;
+    image: string;
+  }[];
+  happyShapes: number[][][];
+}
+
+export function mountMari(host: HTMLElement, initial: MariMode = "idle", art: MariArt): MariController {
+  const abort = new AbortController();
+  const root = document.createElement("span");
+  root.dataset.mariAvatar = "";
+  root.dataset.mode = initial;
+  root.style.cssText =
+    "display:block;position:relative;width:100%;height:100%;overflow:hidden;border-radius:22%;background:#1b1c1e";
+  const fallback = new Image();
+  fallback.src = art.source;
+  fallback.alt = "";
+  fallback.draggable = false;
+  fallback.style.cssText = "display:block;position:absolute;width:100%;height:100%;object-fit:contain";
+  root.append(fallback);
+  const svg = document.createElementNS("http://www.w3.org/2000/svg", "svg");
+  svg.setAttribute("viewBox", "0 0 1254 1254");
+  svg.setAttribute("aria-hidden", "true");
+  svg.style.cssText = "display:block;position:absolute;width:100%;height:100%;visibility:hidden";
+  root.append(svg);
+  const style = document.createElement("style");
+  style.textContent = `${motion.replaceAll("@keyframes ", "@keyframes mari-v7-")}
+[data-mari-avatar] .pose{transform-origin:627px 760px;animation:mari-v7-breathe 5s ease-in-out infinite}
+[data-mari-avatar] .blink{transform-origin:0px 0px;animation:mari-v7-blink 5.4s linear infinite}
+[data-mari-avatar] .eye-happy{display:none}
+[data-mari-avatar][data-mode="thinking"] .pose{animation:mari-v7-ponder 3.6s ease-in-out infinite}
+[data-mari-avatar][data-mode="thinking"] .gaze{animation:mari-v7-look 4.2s ease-in-out infinite}
+[data-mari-avatar][data-paused="true"] *{animation-play-state:paused!important}
+[data-mari-avatar][data-still="true"] *{animation:none!important;transition:none!important}
+[data-mari-avatar][data-still="true"] .pose,[data-mari-avatar][data-still="true"] .gaze{transform:none!important}
+@media(prefers-reduced-motion:reduce){[data-mari-avatar] *{animation:none!important;transition:none!important}}`;
+  root.append(style);
+  host.append(root);
+  const node = <K extends keyof SVGElementTagNameMap>(
+    tag: K,
+    attributes: [string, string | number][],
+    parent: SVGElement,
+  ) => {
+    const element = document.createElementNS("http://www.w3.org/2000/svg", tag);
+    for (const [key, value] of attributes) element.setAttribute(key, String(value));
+    parent.append(element);
+    return element;
+  };
+  const outline = (source: number[][]) => {
+    const points = source.map(([x, y]) => {
+      if (x === undefined || y === undefined) {
+        throw new Error("Invalid bundled Mari point");
+      }
+      return { x, y };
+    });
+    const middle = (a: { x: number; y: number }, b: { x: number; y: number }) =>
+      `${((a.x + b.x) / 2).toFixed(3)} ${((a.y + b.y) / 2).toFixed(3)}`;
+    const first = points[0],
+      last = points[points.length - 1];
+    if (!first || !last) {
+      throw new Error("Missing bundled Mari outline");
+    }
+    let d = `M${middle(last, first)}`;
+    for (const [index, current] of points.entries()) {
+      const next = points[(index + 1) % points.length];
+      if (!next) {
+        throw new Error("Missing bundled Mari point");
+      }
+      d += `Q${current.x.toFixed(3)} ${current.y.toFixed(3)} ${middle(current, next)}`;
+    }
+    return `${d}Z`;
+  };
+  const pose = node("g", [["class", "pose"]], svg);
+  node(
+    "image",
+    [
+      ["href", art.base],
+      ["x", 0],
+      ["y", 0],
+      ["width", 1254],
+      ["height", 1254],
+    ],
+    pose,
+  );
+  const eyes = art.eyes.map((eye, index) => {
+    const [left, top, right, bottom] = eye.bounds;
+    const happyShape = art.happyShapes[index];
+    if (left === undefined || top === undefined || right === undefined || bottom === undefined || !happyShape) {
+      throw new Error("Invalid bundled Mari eye");
+    }
+    const anchor = node("g", [["transform", `translate(${eye.cx} ${eye.cy}) rotate(${eye.angle})`]], pose);
+    const gaze = node("g", [["class", "gaze"]], anchor);
+    const blink = node("g", [["class", "blink"]], gaze);
+    const open = node("g", [["transform", `rotate(${-eye.angle})`]], blink);
+    node(
+      "image",
+      [
+        ["href", eye.image],
+        ["x", left - eye.cx],
+        ["y", top - eye.cy],
+        ["width", right - left],
+        ["height", bottom - top],
+      ],
+      open,
+    );
+    const happy = node(
+      "path",
+      [
+        ["class", "eye-happy"],
+        ["d", outline(happyShape)],
+        ["fill", "#1e1e22"],
+      ],
+      gaze,
+    );
+    return { blink, happy };
+  });
+  let selected = initial;
+  let closure = initial === "happy" ? 1 : 0;
+  let frame: number | undefined;
+  let timer: ReturnType<typeof setTimeout> | undefined;
+  let job: { from: number; target: number; start: number; duration: number; pet: boolean } | undefined;
+  let disposed = false;
+  let ready = false;
+  let visible = true;
+  let pageActive = true;
+  let petting = false;
+  const media = matchMedia("(prefers-reduced-motion: reduce)");
+  const paused = () => !visible || document.hidden || !pageActive;
+  const cancel = () => {
+    if (frame !== undefined) cancelAnimationFrame(frame);
+    if (timer !== undefined) clearTimeout(timer);
+    frame = undefined;
+    timer = undefined;
+    job = undefined;
+  };
+  const paint = (value: number) => {
+    closure = Math.max(0, Math.min(1, value));
+    root.dataset.closure = closure.toFixed(5);
+    for (const eye of eyes) {
+      eye.happy.style.display = closure === 1 ? "block" : "none";
+      eye.blink.style.display = closure === 1 ? "none" : "";
+      if (closure === 0) {
+        eye.blink.style.removeProperty("transform");
+        eye.blink.style.removeProperty("animation-name");
+      } else {
+        eye.blink.style.animationName = "none";
+        eye.blink.style.transform = `scaleY(${Math.max(0.02, 1 - closure)})`;
+      }
+    }
+  };
+  const complete = (target: number, autoReturn: boolean) => {
+    job = undefined;
+    frame = undefined;
+    paint(target);
+    root.dataset.phase = target === 1 ? "happy" : "open";
+    if (autoReturn && !disposed && !paused())
+      timer = setTimeout(() => {
+        timer = undefined;
+        petting = false;
+        request(selected === "happy" ? 1 : 0, false);
+      }, 1100);
+  };
+  const step = (now: number) => {
+    frame = undefined;
+    if (!job || disposed || paused()) return;
+    const progress = Math.min(1, Math.max(0, (now - job.start) / job.duration));
+    paint(job.from + (job.target - job.from) * progress * progress * (3 - 2 * progress));
+    if (progress === 1) complete(job.target, job.pet);
+    else frame = requestAnimationFrame(step);
+  };
+  const request = (target: number, autoReturn: boolean) => {
+    cancel();
+    if (!ready || paused() || media.matches || closure === target) {
+      complete(target, autoReturn);
+      return;
+    }
+    if (closure === 0 && target === 1) {
+      const eye = eyes[0];
+      if (!eye) {
+        throw new Error("Missing bundled Mari eye");
+      }
+      const transform = getComputedStyle(eye.blink).transform;
+      closure = transform === "none" ? 0 : Math.max(0, Math.min(1, 1 - new DOMMatrix(transform).d));
+    }
+    root.dataset.phase = target === 1 ? "closing" : "opening";
+    job = {
+      from: closure,
+      target,
+      start: performance.now(),
+      duration: (target === 1 ? 180 : 240) * Math.abs(target - closure),
+      pet: autoReturn,
+    };
+    frame = requestAnimationFrame(step);
+  };
+  const sync = () => {
+    root.dataset.paused = String(paused());
+    root.dataset.still = String(media.matches);
+    if (paused()) {
+      cancel();
+      petting = false;
+      paint(selected === "happy" ? 1 : 0);
+    } else if (media.matches && job) complete(job.target, job.pet);
+  };
+  const listen = (target: EventTarget, event: string, callback: EventListener) =>
+    target.addEventListener(event, callback, { signal: abort.signal });
+  const observer = new IntersectionObserver((entries) => {
+    visible = entries[0]?.isIntersecting ?? false;
+    sync();
+  });
+  observer.observe(root);
+  listen(media, "change", () => {
+    if (media.matches) {
+      const target = job?.target ?? closure;
+      const pendingPet = petting;
+      cancel();
+      complete(target, pendingPet);
+    }
+    sync();
+  });
+  listen(document, "visibilitychange", sync);
+  listen(window, "pagehide", () => {
+    pageActive = false;
+    sync();
+  });
+  listen(window, "pageshow", () => {
+    pageActive = true;
+    sync();
+  });
+  const controller: MariController = {
+    setMode(mode) {
+      if (disposed || (mode === selected && !petting)) return;
+      selected = mode;
+      petting = false;
+      root.dataset.mode = mode;
+      request(mode === "happy" ? 1 : 0, false);
+    },
+    pet() {
+      if (disposed || !ready || paused()) return;
+      petting = true;
+      request(1, true);
+    },
+    dispose() {
+      if (disposed) return;
+      disposed = true;
+      cancel();
+      abort.abort();
+      observer.disconnect();
+      root.remove();
+    },
+  };
+  listen(root, "pointerdown", () => controller.pet());
+  const decode = async (src: string) => {
+    const image = new Image();
+    image.src = src;
+    await image.decode();
+  };
+  Promise.all([decode(art.base), ...art.eyes.map((eye) => decode(eye.image))])
+    .then(() => {
+      if (disposed) return;
+      ready = true;
+      root.dataset.ready = "true";
+      svg.style.visibility = "";
+      fallback.style.visibility = "hidden";
+      paint(closure);
+      sync();
+    })
+    .catch(() => {
+      if (!disposed) root.dataset.error = "image-decode";
+    });
+  paint(closure);
+  sync();
+  return controller;
+}

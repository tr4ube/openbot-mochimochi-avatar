+@keyframes breathe {
+  0%,
+  100% {
+    transform: translate(0, 0) rotate(0deg);
+  }
+  35% {
+    transform: translate(0, -3px) rotate(0.28deg);
+  }
+  70% {
+    transform: translate(0, -1px) rotate(-0.22deg);
+  }
+}
+@keyframes blink {
+  0%,
+  19%,
+  23%,
+  73%,
+  77%,
+  100% {
+    transform: scaleY(1);
+  }
+  21%,
+  75% {
+    transform: scaleY(0.045);
+  }
+}
+@keyframes ponder {
+  0%,
+  100% {
+    transform: translate(0, 0) rotate(-0.25deg);
+  }
+  50% {
+    transform: translate(0, -4px) rotate(0.65deg);
+  }
+}
+@keyframes look {
+  0%,
+  25%,
+  100% {
+    transform: translate(3px, -10px);
+  }
+  48%,
+  78% {
+    transform: translate(-6px, -8px);
+  }
+}
diff --git a/packages/ui/src/features/agents/character-art.ts b/packages/ui/src/features/agents/character-art.ts
new file mode 100644
index 0000000..aef1b7d
--- /dev/null
+++ b/packages/ui/src/features/agents/character-art.ts
@@ -0,0 +1,45 @@
+import { type CharacterArtEntry, isCharacterArt } from "@openbot/contracts/character-art";
+import { createSignal } from "solid-js";
+import haloArt from "./halo-art.json";
+import mariArt from "./mari-art.json";
+import type { MariArt } from "./mari-renderer";
+import { HALO_AVATAR_SEED, MARI_AVATAR_SEED } from "./mari-seed";
+
+export interface CharacterChoice {
+  seed: string;
+  name: string;
+}
+
+function bundledArt(value: unknown): MariArt {
+  if (!isCharacterArt(value)) throw new Error("Invalid bundled character art.");
+  return value;
+}
+
+const BUNDLED: readonly (CharacterChoice & { art: MariArt })[] = [
+  { seed: MARI_AVATAR_SEED, name: "Mari", art: bundledArt(mariArt) },
+  { seed: HALO_AVATAR_SEED, name: "Halo", art: bundledArt(haloArt) },
+];
+
+// The characters the host keeps in its characters folder. A host file wins over a bundled one with
+// the same seed, so a bundled character can be replaced without a build.
+const [hostCharacters, setHostCharacters] = createSignal<readonly CharacterArtEntry[]>([]);
+
+export function setCharacterArtEntries(entries: readonly CharacterArtEntry[]): void {
+  setHostCharacters(entries);
+}
+
+export function characterArt(seed: string): MariArt | undefined {
+  return (
+    hostCharacters().find((entry) => entry.seed === seed)?.art ?? BUNDLED.find((entry) => entry.seed === seed)?.art
+  );
+}
+
+export function characterChoices(): CharacterChoice[] {
+  const host = hostCharacters();
+  const choices: CharacterChoice[] = BUNDLED.map(({ seed, name }) => ({
+    seed,
+    name: host.find((entry) => entry.seed === seed)?.name ?? name,
+  }));
+  for (const { seed, name } of host) if (!choices.some((choice) => choice.seed === seed)) choices.push({ seed, name });
+  return choices;
+}

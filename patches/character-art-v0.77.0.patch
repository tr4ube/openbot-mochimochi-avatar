diff --git a/apps/mobile/src/features/agents/components/mari-avatar.tsx b/apps/mobile/src/features/agents/components/mari-avatar.tsx
new file mode 100644
index 0000000..7dae690
--- /dev/null
+++ b/apps/mobile/src/features/agents/components/mari-avatar.tsx
@@ -0,0 +1,314 @@
+import type { AvatarMood } from "@openbot/brand/bloub-avatar-motion";
+import type { CharacterArt } from "@openbot/contracts/character-art";
+import { memo, useEffect, useId, useMemo } from "react";
+import { AppState, View } from "react-native";
+import Animated, {
+  type DerivedValue,
+  useAnimatedProps,
+  useDerivedValue,
+  useFrameCallback,
+  useSharedValue,
+} from "react-native-reanimated";
+import Svg, { Defs, FeColorMatrix, Filter, G, Path, Image as SvgImage } from "react-native-svg";
+import { MARI_CHARACTER_ART } from "@/features/agents/model/character-art";
+import {
+  type MariLoopFrame,
+  type MariLoopPhases,
+  type MariMode,
+  mariClosureDuration,
+  mariLoopFrame,
+  mariLoopsSync,
+  mariModeForMood,
+  mariOutline,
+  mariPoseMatrix,
+} from "@/features/agents/model/mari-motion";
+import { useAppDrawerShownOnUI } from "@/features/servers/components/app-drawer-activity";
+import { DISCONNECTED_APPEARANCE } from "@/features/workspace/components/use-connection-appearance";
+import { useMotionPreference } from "@/shared/lib/motion";
+import { isAndroid } from "@/shared/lib/platform";
+import { useScreenFocusedWhile } from "@/shared/lib/use-screen-focused-while";
+
+const MARI_BACKGROUND = "#1b1c1e";
+const MARI_HAPPY_FILL = "#1e1e22";
+const MARI_REST_FRAME: MariLoopFrame = { translateY: 0, rotate: 0, eyeScaleY: 1, gazeX: 0, gazeY: 0 };
+
+interface MariEyeArt {
+  cx: number;
+  cy: number;
+  angle: number;
+  x: number;
+  y: number;
+  width: number;
+  height: number;
+  image: string;
+  happyPath: string;
+}
+
+function mariEyes(art: CharacterArt): readonly MariEyeArt[] {
+  return art.eyes.map((eye, index) => {
+    const [left, top, right, bottom] = eye.bounds;
+    const happyShape = art.happyShapes[index];
+    if (left === undefined || top === undefined || right === undefined || bottom === undefined || !happyShape) {
+      throw new Error("Invalid bundled Mari eye");
+    }
+    return {
+      cx: eye.cx,
+      cy: eye.cy,
+      angle: eye.angle,
+      x: left - eye.cx,
+      y: top - eye.cy,
+      width: right - left,
+      height: bottom - top,
+      image: eye.image,
+      happyPath: mariOutline(happyShape),
+    };
+  });
+}
+
+const AnimatedG = Animated.createAnimatedComponent(G);
+const AnimatedPath = Animated.createAnimatedComponent(Path);
+
+interface MariSvgUpdate {
+  matrix?: number[];
+  opacity?: number;
+}
+
+interface MariClosureJob {
+  value: number;
+  overriding: boolean;
+  from: number;
+  to: number;
+  start: number;
+  duration: number;
+}
+
+function useMariPortrait(mode: MariMode, animate: boolean, disconnected: boolean) {
+  const still = !useMotionPreference("agentFaces");
+  const wantsMotion = !disconnected && (mode === "thinking" || animate);
+  const focused = useScreenFocusedWhile(wantsMotion && !still);
+  const active = wantsMotion && focused && !still;
+  const drawerShown = useAppDrawerShownOnUI();
+  const drawerCovered = drawerShown.get();
+  const resting = mode === "happy" ? 1 : 0;
+  const elapsed = useSharedValue(0);
+  const closure = useSharedValue<MariClosureJob>({
+    value: resting,
+    overriding: resting === 1,
+    from: resting,
+    to: resting,
+    start: -1,
+    duration: 0,
+  });
+  const phases = useSharedValue<MariLoopPhases>({ mode, pose: 0, look: 0, blink: 0 });
+  const frame = useDerivedValue(() => {
+    const current = still ? MARI_REST_FRAME : mariLoopFrame(mode, elapsed.get(), false, phases.get());
+    const job = closure.get();
+    return job.overriding ? { ...current, eyeScaleY: Math.max(0.02, 1 - job.value) } : current;
+  }, [mode, still]);
+  const closed = useDerivedValue(() => closure.get().value);
+
+  const clock = useFrameCallback(({ timeSincePreviousFrame }) => {
+    // The drawer and its scrim cover the home avatars; hold the frame until it closes.
+    if (isAndroid && drawerShown.get()) return;
+    const now = elapsed.get() + Math.min(timeSincePreviousFrame ?? 0, 64);
+    elapsed.set(now);
+    closure.modify((job) => {
+      if (!job.overriding || (job.value === 1 && job.to === 1)) return job;
+      if (job.start < 0) job.start = now;
+      const progress = job.duration <= 0 ? 1 : Math.min(1, Math.max(0, (now - job.start) / job.duration));
+      job.value = job.from + (job.to - job.from) * progress * progress * (3 - 2 * progress);
+      if (progress === 1) {
+        job.value = job.to;
+        if (job.to === 0) {
+          job.overriding = false;
+          phases.modify((current) => {
+            current.blink = now;
+            return current;
+          });
+        }
+      }
+      return job;
+    });
+  }, false);
+
+  useEffect(() => {
+    const update = () => clock.setActive(active && !(isAndroid && drawerCovered) && AppState.currentState === "active");
+    update();
+    const subscription = AppState.addEventListener("change", update);
+    return () => {
+      subscription.remove();
+      clock.setActive(false);
+    };
+  }, [clock, active, drawerCovered]);
+
+  useEffect(() => {
+    const target = mode === "happy" ? 1 : 0;
+    closure.modify((job) => {
+      "worklet";
+      phases.modify((current) =>
+        active ? mariLoopsSync(current, mode, elapsed.get()) : { mode, pose: 0, look: 0, blink: 0 },
+      );
+      if (!active) {
+        job.value = target;
+        job.overriding = target === 1;
+        job.from = target;
+        job.to = target;
+        job.start = -1;
+        job.duration = 0;
+      } else if (job.to !== target) {
+        job.from = job.overriding ? job.value : Math.min(1, Math.max(0, 1 - frame.get().eyeScaleY));
+        job.value = job.from;
+        job.overriding = true;
+        job.to = target;
+        job.start = -1;
+        job.duration = mariClosureDuration(job.from, target);
+      }
+      return job;
+    });
+    if (!active) elapsed.set(0);
+  }, [active, mode, closure, elapsed, frame, phases]);
+
+  return { frame, closed };
+}
+
+export interface MariAvatarProps {
+  mood?: AvatarMood;
+  size?: number;
+  animateIdle?: boolean;
+  disconnected?: boolean;
+  art?: CharacterArt;
+}
+
+export const MariAvatar = memo(function MariAvatar({
+  mood = "idle",
+  size = 54,
+  animateIdle = true,
+  disconnected = false,
+  art = MARI_CHARACTER_ART,
+}: MariAvatarProps) {
+  const eyes = useMemo(() => mariEyes(art), [art]);
+  const { frame, closed } = useMariPortrait(mariModeForMood(mood), animateIdle, disconnected);
+  const filterId = `mari-offline-${useId().replaceAll(":", "")}`;
+  const poseProps = useAnimatedProps<MariSvgUpdate>(() => {
+    const current = frame.get();
+    return { matrix: mariPoseMatrix(current.translateY, current.rotate) };
+  });
+  return (
+    <View
+      pointerEvents="none"
+      style={{
+        width: size,
+        height: size,
+        borderRadius: size * 0.22,
+        overflow: "hidden",
+        backgroundColor: MARI_BACKGROUND,
+      }}
+    >
+      <Svg
+        accessibilityElementsHidden
+        accessible={false}
+        height={size}
+        pointerEvents="none"
+        viewBox="0 0 1254 1254"
+        width={size}
+      >
+        {disconnected ? (
+          <Defs>
+            <Filter id={filterId}>
+              <FeColorMatrix type="saturate" values={[DISCONNECTED_APPEARANCE.saturation]} />
+            </Filter>
+          </Defs>
+        ) : null}
+        <AnimatedG animatedProps={poseProps} filter={disconnected ? `url(#${filterId})` : undefined}>
+          <SvgImage href={art.base} x={0} y={0} width={1254} height={1254} />
+          {eyes.map((eye) => (
+            <G key={eye.cx} transform={`translate(${eye.cx} ${eye.cy}) rotate(${eye.angle})`}>
+              <MariEye closed={closed} eye={eye} frame={frame} />
+            </G>
+          ))}
+        </AnimatedG>
+      </Svg>
+    </View>
+  );
+});
+
+function MariEye({
+  eye,
+  frame,
+  closed,
+}: {
+  eye: MariEyeArt;
+  frame: DerivedValue<MariLoopFrame>;
+  closed: DerivedValue<number>;
+}) {
+  const gazeProps = useAnimatedProps<MariSvgUpdate>(() => {
+    const current = frame.get();
+    return { matrix: [1, 0, 0, 1, current.gazeX, current.gazeY] };
+  });
+  const blinkProps = useAnimatedProps<MariSvgUpdate>(() => {
+    const closure = closed.get();
+    const scaleY = closure > 0 ? Math.max(0.02, 1 - closure) : frame.get().eyeScaleY;
+    return { matrix: [1, 0, 0, scaleY, 0, 0], opacity: closure === 1 ? 0 : 1 };
+  });
+  const happyProps = useAnimatedProps<MariSvgUpdate>(() => ({ opacity: closed.get() === 1 ? 1 : 0 }));
+  return (
+    <AnimatedG animatedProps={gazeProps}>
+      <AnimatedG animatedProps={blinkProps}>
+        <G transform={`rotate(${-eye.angle})`}>
+          <SvgImage href={eye.image} x={eye.x} y={eye.y} width={eye.width} height={eye.height} />
+        </G>
+      </AnimatedG>
+      <AnimatedPath animatedProps={happyProps} d={eye.happyPath} fill={MARI_HAPPY_FILL} opacity={0} />
+    </AnimatedG>
+  );
+}
+
+export const MariAvatarThumbnail = memo(function MariAvatarThumbnail({
+  size = 48,
+  disconnected = false,
+  art = MARI_CHARACTER_ART,
+}: {
+  size?: number;
+  disconnected?: boolean;
+  art?: CharacterArt;
+}) {
+  const filterId = `mari-offline-${useId().replaceAll(":", "")}`;
+  return (
+    <View
+      pointerEvents="none"
+      style={{
+        width: size,
+        height: size,
+        borderRadius: size * 0.22,
+        overflow: "hidden",
+        backgroundColor: MARI_BACKGROUND,
+      }}
+    >
+      <Svg
+        accessibilityElementsHidden
+        accessible={false}
+        height={size}
+        opacity={disconnected ? DISCONNECTED_APPEARANCE.opacity : 1}
+        pointerEvents="none"
+        viewBox="0 0 1254 1254"
+        width={size}
+      >
+        {disconnected ? (
+          <Defs>
+            <Filter id={filterId}>
+              <FeColorMatrix type="saturate" values={[DISCONNECTED_APPEARANCE.saturation]} />
+            </Filter>
+          </Defs>
+        ) : null}
+        <SvgImage
+          filter={disconnected ? `url(#${filterId})` : undefined}
+          href={art.source}
+          x={0}
+          y={0}
+          width={1254}
+          height={1254}
+        />
+      </Svg>
+    </View>
+  );
+});

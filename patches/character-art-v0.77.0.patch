diff --git a/src/main/team-api/route-character-art.ts b/src/main/team-api/route-character-art.ts
new file mode 100644
index 0000000..55f001b
--- /dev/null
+++ b/src/main/team-api/route-character-art.ts
@@ -0,0 +1,18 @@
+import { isCharacterSeed } from "@openbot/contracts/character-art";
+import { CHARACTER_ART_ROUTES, characterArtJson } from "@openbot/contracts/team-protocol/character-art-v1";
+import { sharedCharacterArtStore } from "../character-art-store";
+import { HttpError } from "./http-error";
+import type { RouteOutcome, TeamApiRequestContext } from "./request-context";
+import { readJson } from "./request-helpers";
+
+/** The art of one character seed on this computer. Local `character-art-v1`. */
+export async function routeCharacterArt(context: TeamApiRequestContext): Promise<RouteOutcome> {
+  const { method, url, request, json } = context;
+  if (method !== "POST" || url.pathname !== CHARACTER_ART_ROUTES.read) return "unmatched";
+  const body = await readJson(request);
+  const seed = typeof body.seed === "string" ? body.seed : "";
+  if (!isCharacterSeed(seed)) throw new HttpError(400, "seed is invalid.");
+  const art = sharedCharacterArtStore()?.art(seed);
+  if (!art) throw new HttpError(404, "The character was not found.");
+  return json(200, { seed, art: characterArtJson(art) });
+}
diff --git a/src/preload/character-art-decoding.ts b/src/preload/character-art-decoding.ts
new file mode 100644
index 0000000..85be8b9
--- /dev/null
+++ b/src/preload/character-art-decoding.ts
@@ -0,0 +1,21 @@
+// The character portraits, as main lists them.
+
+import { type CharacterArtEntry, isCharacterArtEntry } from "@openbot/contracts/character-art";
+
+export function decodeCharacterArtEntries(value: unknown): CharacterArtEntry[] {
+  if (!Array.isArray(value)) throw new Error("Invalid character list.");
+  return value.map((entry) => {
+    if (!isCharacterArtEntry(entry)) throw new Error("Invalid character.");
+    const { seed, name, art } = entry;
+    return {
+      seed,
+      name,
+      art: {
+        source: art.source,
+        base: art.base,
+        eyes: art.eyes.map((eye) => ({ ...eye, bounds: [...eye.bounds], darkBounds: [...eye.darkBounds] })),
+        happyShapes: art.happyShapes.map((shape) => shape.map((point) => [...point])),
+      },
+    };
+  });
+}

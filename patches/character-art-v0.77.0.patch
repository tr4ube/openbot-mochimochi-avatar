new file mode 100644
index 0000000..0adda21
--- /dev/null
+++ b/src/main/character-art-store.ts
@@ -0,0 +1,96 @@
+// The layered character portraits of this computer: one `<id>.json` file each in
+// `<userData>/characters`, selected by an agent with the avatar seed `character:<id>`. A file is
+// read again only when its size or modification time changes, so adding a file needs no restart.
+import { readdirSync, readFileSync, statSync } from "node:fs";
+import { join } from "node:path";
+import {
+  type CharacterArt,
+  type CharacterArtEntry,
+  characterSeed,
+  isCharacterArt,
+  isCharacterSeed,
+} from "@openbot/contracts/character-art";
+
+const MAX_FILE_BYTES = 8 * 1024 * 1024;
+const MAX_CHARACTERS = 64;
+
+interface CachedFile {
+  stamp: string;
+  entry: CharacterArtEntry | null;
+}
+
+export class CharacterArtStore {
+  readonly #folder: string;
+  readonly #cache = new Map<string, CachedFile>();
+
+  constructor(userDataPath: string) {
+    this.#folder = join(userDataPath, "characters");
+  }
+
+  list(): CharacterArtEntry[] {
+    let names: string[];
+    try {
+      names = readdirSync(this.#folder).filter((name) => name.endsWith(".json"));
+    } catch {
+      return [];
+    }
+    names.sort();
+    const entries: CharacterArtEntry[] = [];
+    for (const name of names.slice(0, MAX_CHARACTERS)) {
+      const entry = this.#read(name);
+      if (entry) entries.push(entry);
+    }
+    return entries;
+  }
+
+  art(seed: string): CharacterArt | null {
+    if (!isCharacterSeed(seed)) return null;
+    return this.list().find((entry) => entry.seed === seed)?.art ?? null;
+  }
+
+  #read(name: string): CharacterArtEntry | null {
+    const id = name.slice(0, -".json".length);
+    const seed = characterSeed(id);
+    if (!seed) return null;
+    const path = join(this.#folder, name);
+    let stamp: string;
+    try {
+      const stat = statSync(path);
+      if (!stat.isFile() || stat.size > MAX_FILE_BYTES) return null;
+      stamp = `${stat.size}:${stat.mtimeMs}`;
+    } catch {
+      return null;
+    }
+    const cached = this.#cache.get(name);
+    if (cached?.stamp === stamp) return cached.entry;
+    let entry: CharacterArtEntry | null = null;
+    try {
+      entry = characterEntry(id, seed, JSON.parse(readFileSync(path, "utf8")));
+    } catch {
+      entry = null;
+    }
+    this.#cache.set(name, { stamp, entry });
+    return entry;
+  }
+}
+
+function characterEntry(id: string, seed: string, value: unknown): CharacterArtEntry | null {
+  if (!isCharacterArt(value)) return null;
+  const label = "name" in value && typeof value.name === "string" ? value.name.trim().slice(0, 100) : "";
+  return {
+    seed,
+    name: label || id.charAt(0).toUpperCase() + id.slice(1).replace(/-v\d+$/u, ""),
+    art: { source: value.source, base: value.base, eyes: value.eyes, happyShapes: value.happyShapes },
+  };
+}
+
+let shared: CharacterArtStore | null = null;
+
+/** The one store of this process, set when the app starts, for the Team API route. */
+export function setSharedCharacterArtStore(store: CharacterArtStore): void {
+  shared = store;
+}
+
+export function sharedCharacterArtStore(): CharacterArtStore | null {
+  return shared;
+}

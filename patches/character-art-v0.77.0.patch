+import mariArt from "./mari-art.json";
+
+// The bundled portraits answer at once, even before the workspace connects. Any other
+// `character:<id>` seed asks the host's `characters` folder through the optional team route.
+function toCharacterArt(value: unknown, name: string): CharacterArt {
+  if (!isCharacterArt(value)) throw new Error(`Invalid bundled ${name} art.`);
+  return value;
+}
+
+export const MARI_CHARACTER_ART: CharacterArt = toCharacterArt(mariArt, "mari");
+
+const EMBEDDED_ART: Readonly<Record<string, CharacterArt>> = {
+  "character:mari-v1": MARI_CHARACTER_ART,
+  "character:halo-v1": toCharacterArt(haloArt, "halo"),
+};
+
+export const CHARACTER_CHOICES = [
+  { seed: "character:mari-v1", name: "Mari" },
+  { seed: "character:halo-v1", name: "Halo" },
+] as const;
+
+export { isCharacterSeed };
+
+export function embeddedCharacterArt(seed: string): CharacterArt | null {
+  return EMBEDDED_ART[seed] ?? null;
+}
+
+/**
+ * The layered art of one `character:<id>` seed, or null while it loads (or when the host has no
+ * such character): the caller keeps the generated avatar in both cases.
+ */
+export function useCharacterArt(seed: string, serverId?: string): CharacterArt | null {
+  const workspace = useMobileWorkspaceReader();
+  const queryScope = useQueryScope();
+  const hostId = useMobileWorkspaceSelector(
+    (current) => serverId ?? current.agents.find((agent) => agent.avatarSeed === seed)?.serverId ?? null,
+  );
+  const embedded = embeddedCharacterArt(seed);
+  const remote = useQuery({
+    queryKey: queryKeys.characterArt(queryScope, hostId ?? undefined, seed),
+    enabled: embedded === null && isCharacterSeed(seed) && Boolean(hostId),
+    queryFn: () => (hostId ? workspace().loadCharacterArt(seed, hostId) : Promise.reject(new Error("No server."))),
+    staleTime: Infinity,
+    retry: false,
+  });
+  return embedded ?? remote.data ?? null;
+}

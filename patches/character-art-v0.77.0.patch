+import { describe, expect, it } from "vitest";
+import { isMariSeed, mariClosureDuration, mariLoopFrame, mariModeForMood, mariOutline } from "./mari-motion";
+
+describe("local Mari mobile avatar", () => {
+  it("accepts only the selected character seed", () => {
+    expect(isMariSeed("character:mari-v1")).toBe(true);
+    for (const seed of ["mari-v1", "character:mari-v2", "character:mari-v1-extra", "", "generated"])
+      expect(isMariSeed(seed)).toBe(false);
+  });
+
+  it("keeps the existing desktop mood mapping", () => {
+    expect(mariModeForMood("responded")).toBe("happy");
+    expect(mariModeForMood("working")).toBe("thinking");
+    expect(mariModeForMood("connecting")).toBe("thinking");
+    for (const mood of ["idle", "waiting", "failed", "asleep"] as const) expect(mariModeForMood(mood)).toBe("idle");
+  });
+
+  it("starts and ends the accepted five-second breathing loop at rest", () => {
+    const start = mariLoopFrame("idle", 0);
+    expect(start.translateY).toBe(0);
+    expect(start.rotate).toBe(0);
+    expect(start.eyeScaleY).toBe(1);
+    expect(start.gazeX).toBe(0);
+    expect(start.gazeY).toBe(0);
+    expect(mariLoopFrame("idle", 5000).translateY).toBe(0);
+    expect(mariLoopFrame("idle", 1750).translateY).toBe(-3);
+    expect(mariLoopFrame("idle", 1750).rotate).toBe(0.28);
+    expect(mariLoopFrame("idle", 3500).translateY).toBe(-1);
+    expect(mariLoopFrame("idle", 3500).rotate).toBe(-0.22);
+  });
+
+  it("preserves ordinary blink closing and reopening, not a shape morph", () => {
+    expect(mariLoopFrame("idle", 5400 * 0.19).eyeScaleY).toBeCloseTo(1);
+    expect(mariLoopFrame("idle", 5400 * 0.21).eyeScaleY).toBeCloseTo(0.045);
+    expect(mariLoopFrame("idle", 5400 * 0.23).eyeScaleY).toBeCloseTo(1);
+    expect(mariLoopFrame("idle", 5400 * 0.75).eyeScaleY).toBeCloseTo(0.045);
+    expect(mariLoopFrame("idle", 5400 * 0.77).eyeScaleY).toBeCloseTo(1);
+    expect(mariLoopFrame("idle", 5400 * 0.2).eyeScaleY).toBeCloseTo(0.5225);
+  });
+
+  it("keeps the accepted thinking pose and gaze timing", () => {
+    expect(mariLoopFrame("thinking", 0).rotate).toBe(-0.25);
+    expect(mariLoopFrame("thinking", 1800).translateY).toBe(-4);
+    expect(mariLoopFrame("thinking", 1800).rotate).toBe(0.65);
+    expect(mariLoopFrame("thinking", 0).gazeX).toBe(3);
+    expect(mariLoopFrame("thinking", 0).gazeY).toBe(-10);
+    expect(mariLoopFrame("thinking", 4200 * 0.48).gazeX).toBe(-6);
+    expect(mariLoopFrame("thinking", 4200 * 0.48).gazeY).toBe(-8);
+    expect(mariLoopFrame("thinking", 4200).gazeX).toBe(3);
+  });
+
+  it("holds every loop still for motion-disabled rendering", () => {
+    for (const mode of ["idle", "thinking", "happy"] as const) {
+      expect(mariLoopFrame(mode, 1379, true)).toEqual({
+        translateY: 0,
+        rotate: 0,
+        eyeScaleY: 1,
+        gazeX: 0,
+        gazeY: 0,
+      });
+    }
+  });
+
+  it("scales interruption duration from the current closure", () => {
+    expect(mariClosureDuration(0, 1)).toBe(180);
+    expect(mariClosureDuration(1, 0)).toBe(240);
+    expect(mariClosureDuration(0.5, 1)).toBe(90);
+    expect(mariClosureDuration(0.5, 0)).toBe(120);
+    expect(mariClosureDuration(0.5, 0.5)).toBe(0);
+  });
+
+  it("constructs the accepted rounded happy outline without changing its points", () => {
+    const points = [
+      [0, 0],
+      [2, 0],
+      [2, 2],
+      [0, 2],
+    ] as const;
+    expect(mariOutline(points)).toBe(
+      "M0.000 1.000Q0.000 0.000 1.000 0.000Q2.000 0.000 2.000 1.000Q2.000 2.000 1.000 2.000Q0.000 2.000 0.000 1.000Z",
+    );
+    expect(points).toEqual([
+      [0, 0],
+      [2, 0],
+      [2, 2],
+      [0, 2],
+    ]);
+  });
+});

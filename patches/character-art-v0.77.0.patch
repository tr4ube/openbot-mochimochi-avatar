new file mode 100644
index 0000000..12c6d9b
--- /dev/null
+++ b/packages/contracts/src/character-art.ts
@@ -0,0 +1,95 @@
+// A layered character portrait: a body image, eye images that blink and look, and closed "happy"
+// eye outlines. The host reads them from `<userData>/characters/<id>.json` and an agent selects one
+// with the avatar seed `character:<id>`, so a new character needs no new build of any client.
+import { isDynamicRecord, isNumber, isString } from "./runtime-values";
+
+export const CHARACTER_SEED_PREFIX = "character:";
+const CHARACTER_ID = /^[a-z0-9-]{1,100}$/u;
+const IMAGE_DATA_URL = /^data:image\/(?:png|webp|jpeg);base64,[A-Za-z0-9+/=]+$/u;
+const MAX_IMAGE_CHARS = 2 * 1024 * 1024;
+
+export type CharacterBounds = [number, number, number, number];
+
+export interface CharacterEyeArt {
+  name: string;
+  cx: number;
+  cy: number;
+  angle: number;
+  bounds: CharacterBounds;
+  darkBounds: CharacterBounds;
+  pixelCount: number;
+  image: string;
+}
+
+export interface CharacterArt {
+  source: string;
+  base: string;
+  eyes: CharacterEyeArt[];
+  happyShapes: number[][][];
+}
+
+export interface CharacterArtEntry {
+  seed: string;
+  name: string;
+  art: CharacterArt;
+}
+
+export function characterSeed(id: string): string | null {
+  return CHARACTER_ID.test(id) ? `${CHARACTER_SEED_PREFIX}${id}` : null;
+}
+
+export function isCharacterSeed(seed: string): boolean {
+  return seed.startsWith(CHARACTER_SEED_PREFIX) && CHARACTER_ID.test(seed.slice(CHARACTER_SEED_PREFIX.length));
+}
+
+const isImage = (value: unknown): value is string =>
+  isString(value) && value.length <= MAX_IMAGE_CHARS && IMAGE_DATA_URL.test(value);
+const isFiniteNumber = (value: unknown): value is number => isNumber(value) && Number.isFinite(value);
+const isBounds = (value: unknown): value is CharacterBounds =>
+  Array.isArray(value) && value.length === 4 && value.every(isFiniteNumber);
+const isPoint = (value: unknown): value is number[] =>
+  Array.isArray(value) && value.length === 2 && value.every(isFiniteNumber);
+
+function isEye(value: unknown): value is CharacterEyeArt {
+  return (
+    isDynamicRecord(value) &&
+    isString(value.name) &&
+    value.name.length <= 100 &&
+    isFiniteNumber(value.cx) &&
+    isFiniteNumber(value.cy) &&
+    isFiniteNumber(value.angle) &&
+    isBounds(value.bounds) &&
+    isBounds(value.darkBounds) &&
+    isFiniteNumber(value.pixelCount) &&
+    isImage(value.image)
+  );
+}
+
+export function isCharacterArt(value: unknown): value is CharacterArt {
+  return (
+    isDynamicRecord(value) &&
+    isImage(value.source) &&
+    isImage(value.base) &&
+    Array.isArray(value.eyes) &&
+    value.eyes.length >= 1 &&
+    value.eyes.length <= 4 &&
+    value.eyes.every(isEye) &&
+    Array.isArray(value.happyShapes) &&
+    value.happyShapes.length === value.eyes.length &&
+    value.happyShapes.every(
+      (shape) => Array.isArray(shape) && shape.length >= 3 && shape.length <= 2_000 && shape.every(isPoint),
+    )
+  );
+}
+
+export function isCharacterArtEntry(value: unknown): value is CharacterArtEntry {
+  return (
+    isDynamicRecord(value) &&
+    isString(value.seed) &&
+    isCharacterSeed(value.seed) &&
+    isString(value.name) &&
+    value.name.length >= 1 &&
+    value.name.length <= 100 &&
+    isCharacterArt(value.art)
+  );
+}

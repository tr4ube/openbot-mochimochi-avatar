index 0000000..da84dd1
--- /dev/null
+++ b/apps/mobile/src/features/agents/model/mari-motion.ts
@@ -0,0 +1,196 @@
+import type { AvatarMood } from "@openbot/brand/bloub-avatar-motion";
+
+export type MariMode = "idle" | "thinking" | "happy";
+
+export interface MariLoopFrame {
+  translateY: number;
+  rotate: number;
+  eyeScaleY: number;
+  gazeX: number;
+  gazeY: number;
+}
+
+export interface MariLoopOrigins {
+  pose: number;
+  look: number;
+  blink: number;
+}
+
+export interface MariLoopPhases extends MariLoopOrigins {
+  mode: MariMode;
+}
+
+const MARI_SEED = "character:mari-v1";
+
+export function isMariSeed(seed: string): boolean {
+  return seed === MARI_SEED;
+}
+
+export function mariModeForMood(mood: AvatarMood): MariMode {
+  return mood === "responded" ? "happy" : mood === "working" || mood === "connecting" ? "thinking" : "idle";
+}
+
+const BREATHE_MS = 5000;
+const BLINK_MS = 5400;
+const PONDER_MS = 3600;
+const LOOK_MS = 4200;
+
+const BREATHE: readonly (readonly number[])[] = [
+  [0, 0, 0],
+  [0.35, -3, 0.28],
+  [0.7, -1, -0.22],
+  [1, 0, 0],
+];
+const PONDER: readonly (readonly number[])[] = [
+  [0, 0, -0.25],
+  [0.5, -4, 0.65],
+  [1, 0, -0.25],
+];
+const LOOK: readonly (readonly number[])[] = [
+  [0, 3, -10],
+  [0.25, 3, -10],
+  [0.48, -6, -8],
+  [0.78, -6, -8],
+  [1, 3, -10],
+];
+const BLINK: readonly (readonly number[])[] = [
+  [0, 1],
+  [0.19, 1],
+  [0.21, 0.045],
+  [0.23, 1],
+  [0.73, 1],
+  [0.75, 0.045],
+  [0.77, 1],
+  [1, 1],
+];
+
+function cubicBezierY(x: number, x1: number, y1: number, x2: number, y2: number): number {
+  "worklet";
+  if (x <= 0) return 0;
+  if (x >= 1) return 1;
+  const ax = 1 - 3 * x2 + 3 * x1;
+  const bx = 3 * x2 - 6 * x1;
+  const cx = 3 * x1;
+  const ay = 1 - 3 * y2 + 3 * y1;
+  const by = 3 * y2 - 6 * y1;
+  const cy = 3 * y1;
+  let t = x;
+  for (let i = 0; i < 8; i++) {
+    const error = ((ax * t + bx) * t + cx) * t - x;
+    if (Math.abs(error) < 1e-6) break;
+    const slope = 3 * ax * t * t + 2 * bx * t + cx;
+    if (Math.abs(slope) < 1e-6) break;
+    t -= error / slope;
+    if (t < 0) t = 0;
+    else if (t > 1) t = 1;
+  }
+  if (Math.abs(((ax * t + bx) * t + cx) * t - x) > 1e-6) {
+    let lo = 0;
+    let hi = 1;
+    t = x;
+    for (let i = 0; i < 30; i++) {
+      const value = ((ax * t + bx) * t + cx) * t;
+      if (Math.abs(value - x) < 1e-6) break;
+      if (value < x) lo = t;
+      else hi = t;
+      t = (lo + hi) / 2;
+    }
+  }
+  return ((ay * t + by) * t + cy) * t;
+}
+
+// CSS ease-in-out: cubic-bezier(0.42, 0, 0.58, 1), applied per keyframe interval.
+function easeInOut(progress: number): number {
+  "worklet";
+  return cubicBezierY(progress, 0.42, 0, 0.58, 1);
+}
+
+function sampleChannel(stops: readonly (readonly number[])[], channel: number, offset: number, eased: boolean): number {
+  "worklet";
+  const first = stops[0];
+  const last = stops[stops.length - 1];
+  if (!first || !last) return 0;
+  const firstOffset = first[0] ?? 0;
+  const lastOffset = last[0] ?? 0;
+  if (offset <= firstOffset) return first[channel] ?? 0;
+  if (offset >= lastOffset) return last[channel] ?? 0;
+  for (let index = 1; index < stops.length; index++) {
+    const previous = stops[index - 1];
+    const next = stops[index];
+    if (!previous || !next) return 0;
+    const previousOffset = previous[0] ?? 0;
+    const nextOffset = next[0] ?? 0;
+    if (offset > nextOffset) continue;
+    if (offset === nextOffset) return next[channel] ?? 0;
+    const span = nextOffset - previousOffset;
+    const raw = span <= 0 ? 1 : (offset - previousOffset) / span;
+    const progress = eased ? easeInOut(raw) : raw;
+    return (previous[channel] ?? 0) + ((next[channel] ?? 0) - (previous[channel] ?? 0)) * progress;
+  }
+  return last[channel] ?? 0;
+}
+
+export function mariLoopFrame(
+  mode: MariMode,
+  elapsedMs: number,
+  still = false,
+  origins?: MariLoopOrigins,
+): MariLoopFrame {
+  "worklet";
+  if (still) return { translateY: 0, rotate: 0, eyeScaleY: 1, gazeX: 0, gazeY: 0 };
+  const thinking = mode === "thinking";
+  const pose = thinking ? PONDER : BREATHE;
+  const poseDuration = thinking ? PONDER_MS : BREATHE_MS;
+  const poseOffset = ((elapsedMs - (origins?.pose ?? 0)) % poseDuration) / poseDuration;
+  const blinkOffset = ((elapsedMs - (origins?.blink ?? 0)) % BLINK_MS) / BLINK_MS;
+  const lookOffset = ((elapsedMs - (origins?.look ?? 0)) % LOOK_MS) / LOOK_MS;
+  return {
+    translateY: sampleChannel(pose, 1, poseOffset, true),
+    rotate: sampleChannel(pose, 2, poseOffset, true),
+    eyeScaleY: sampleChannel(BLINK, 1, blinkOffset, false),
+    gazeX: thinking ? sampleChannel(LOOK, 1, lookOffset, true) : 0,
+    gazeY: thinking ? sampleChannel(LOOK, 2, lookOffset, true) : 0,
+  };
+}
+
+export function mariLoopsSync(phases: MariLoopPhases, mode: MariMode, now: number): MariLoopPhases {
+  "worklet";
+  if (phases.mode === mode) return phases;
+  if ((phases.mode === "thinking") === (mode === "thinking")) return { ...phases, mode };
+  return { mode, pose: now, look: now, blink: phases.blink };
+}
+
+// Native RNSVG affine matrix [a, b, c, d, tx, ty] for translate(0, y) rotate(deg, 627, 760).
+export function mariPoseMatrix(translateY: number, degrees: number): number[] {
+  "worklet";
+  const radians = (degrees * Math.PI) / 180;
+  const cos = Math.cos(radians);
+  const sin = Math.sin(radians);
+  return [cos, sin, -sin, cos, 627 - 627 * cos + 760 * sin, translateY + 760 - 627 * sin - 760 * cos];
+}
+
+export function mariClosureDuration(from: number, to: number): number {
+  "worklet";
+  return (to === 1 ? 180 : 240) * Math.abs(to - from);
+}
+
+export function mariOutline(points: readonly (readonly number[])[]): string {
+  const corners = points.map((point) => {
+    const x = point[0];
+    const y = point[1];
+    if (x === undefined || y === undefined) throw new Error("Invalid bundled Mari point");
+    return { x, y };
+  });
+  const middle = (a: { x: number; y: number }, b: { x: number; y: number }) =>
+    `${((a.x + b.x) / 2).toFixed(3)} ${((a.y + b.y) / 2).toFixed(3)}`;
+  const first = corners[0];
+  const last = corners[corners.length - 1];
+  if (!first || !last) throw new Error("Missing bundled Mari outline");
+  let d = `M${middle(last, first)}`;
+  for (const [index, current] of corners.entries()) {
+    const next = corners[(index + 1) % corners.length];
+    if (!next) throw new Error("Missing bundled Mari point");
+    d += `Q${current.x.toFixed(3)} ${current.y.toFixed(3)} ${middle(current, next)}`;
+  }
+  return `${d}Z`;
+}
